# Keep the build context small and the image free of anything local.
.git
.gitignore
.env
.env.*
!.env.example
vendor
node_modules
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*
database/*.sqlite
tests
phpunit.xml
compose.prod.yml
deploy.sh
*.md
