APP_NAME="Skyrim Together VR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://skyrimtogethervr.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# ──────────────────────────────────────────────────────────────────────────────
# Skyrim Together VR
# ──────────────────────────────────────────────────────────────────────────────

# Where the source lives. The download panel reads this repository's newest
# published release from the GitHub API and fills itself in with version, date,
# file sizes and download counts, so a `gh release create` updates the site.
STVR_GITHUB_REPO=Dosylia/SkyrimTogetherVR
STVR_GITHUB_URL=https://github.com/Dosylia/SkyrimTogetherVR
STVR_ISSUES_URL=https://github.com/Dosylia/SkyrimTogetherVR/issues
STVR_RELEASES_URL=https://github.com/Dosylia/SkyrimTogetherVR/releases

# Optional. Without one GitHub allows 60 API calls an hour per IP and the answer
# is cached, so one site will never come close. Add one only if the server shares
# an address with something noisy.
STVR_GITHUB_TOKEN=

# The launcher's repository (private is fine) and a token that can read it:
# a fine-grained token, this one repository, "Contents: Read-only". The site
# keeps a copy of its newest release and serves it; without the token a
# private repository cannot be read and the button says "Not released yet".
STVR_LAUNCHER_REPO=Dosylia/urSovngarde-launcher
STVR_LAUNCHER_TOKEN=
STVR_RELEASE_CACHE_MINUTES=30

# Shown until a release is tagged, and whenever GitHub is unreachable.
# Set STVR_FALLBACK_TAG and the panel names a version; leave it empty and the
# panel says plainly that the build lives on the releases page.
STVR_FALLBACK_TAG=
STVR_FALLBACK_DATE=
STVR_FALLBACK_URL=https://github.com/Dosylia/SkyrimTogetherVR/releases/latest
STVR_FALLBACK_FULL_SIZE=
STVR_FALLBACK_PATCH_SIZE=

# Leave empty and the button does not appear anywhere on the site.
STVR_DISCORD_URL=https://discord.gg/spUf8mMxfJ
STVR_NEXUS_URL=
